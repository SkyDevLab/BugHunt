{
  "name": "bughunt-ai",
  "version": "1.0.0",
  "description": "Ticket-to-Bug autonomous QA Agent plugin for Google Antigravity",
  "main": "src/index.js",
  "bin": {
    "bughunt": "./scripts/run-tests.js"
  },
  "scripts": {
    "test": "node --test tests/",
    "test:unit": "node --test tests/ticket-parser.test.js tests/scope-guard.test.js tests/test-planner.test.js tests/evidence-manager.test.js tests/reproducer.test.js tests/report-generator.test.js tests/inaccessible-app.test.js",
    "test:e2e": "node --test tests/e2e-demo.test.js",
    "demo": "node scripts/demo.js",
    "start:demo": "node fixtures/demo-app/server.js",
    "start:demo:fixed": "node fixtures/demo-app/server.js --fixed",
    "bughunt": "node scripts/run-tests.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkyDevLab/BugHunt.git"
  },
  "keywords": [
    "antigravity",
    "antigravity-plugin",
    "qa",
    "playwright",
    "testing",
    "test-automation",
    "jira",
    "azure-devops",
    "bug-report"
  ],
  "author": "SkyDevLab",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SkyDevLab/BugHunt/issues"
  },
  "homepage": "https://github.com/SkyDevLab/BugHunt#readme",
  "dependencies": {
    "playwright": "^1.42.0"
  }
}
